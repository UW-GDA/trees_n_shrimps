    "CMRI_2017 = comp_2017['CMRI'].clip(min=-1, max=1)\n",
    "CMRI_2026 = comp_2026['CMRI'].clip(min=-1, max=1)\n",
    "\n",
    "gmm = GaussianMixture(n_components=2, random_state=0)\n",
    "gmm.fit(CMRI_2026)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "ax.hist(CMRI_2026, bins=50, density=True, alpha=0.5, label='Data Histogram')\n",
    "\n",
    "xmin, xmax = plt.xlim()\n",
    "x = np.linspace(xmin, xmax, 500).reshape(-1, 1)\n",
    "\n",
    "# Calculate the GMM density and individual component densities\n",
    "log_density = gmm.score_samples(x)\n",
    "y = np.exp(log_density)\n",
    "ax.plot(x, y, color='crimson', lw=3, label='GMM Total Density')\n",
    "\n",
    "# Plot individual components\n",
    "for i in range(n_components):\n",
    "    mean = gmm.means_[i, 0]\n",
    "    std = np.sqrt(gmm.covariances_[i, 0, 0])\n",
    "    weight = gmm.weights_[i]\n",
    "    # The individual component's plot should be scaled by its weight\n",
    "    component_y = weight * norm.pdf(x.ravel(), mean, std)\n",
    "    ax.plot(x.ravel(), component_y, '--', label=f'Component {i+1}')\n",
    "\n",
    "ax.set_xlabel('Value')\n",
    "ax.set_ylabel('Density')\n",
    "ax.set_title('Gaussian Mixture Model Fit to Histogram')\n",
    "ax.legend()\n",
    "plt.show()"
   ]
