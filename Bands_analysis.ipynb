   "source": [
    "#Choose dry season months\n",
    "def filter_dry_season(items, dry_season_months=[12, 1, 2, 3, 4]):\n",
    "    filtered = [\n",
    "        item for item in items\n",
    "        if item.datetime.month in dry_season_months\n",
    "    ]\n",
    "    print(f\"  {len(items)} total → {len(filtered)} dry season scenes\")\n",
    "    return filtered"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "86955a5d-beca-461f-891b-076813cad41d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  7 total → 6 dry season scenes\n"
     ]
    }
   ],
   "source": [
    "#Find dry season images from 2016 and 2017- had to include this because 2016 alone didn't have enough images\n",
    "search_2017 = catalog.search(\n",
    "    collections=[\"sentinel-2-l2a\"],\n",
    "    bbox=bbox,\n",
    "    datetime=\"2015-11-01/2017-04-30\",  # spans two dry seasons\n",
    "    query={\"eo:cloud_cover\": {\"lt\": 25}} #25 percent\n",
    ")\n",
    "\n",
    "items_2017_all = list(search_2017.items())\n",
    "items_2017 = filter_dry_season(items_2017_all)"
   ]
  },
